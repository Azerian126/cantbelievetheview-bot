# Copiá este archivo a .env para probar en tu máquina (nunca lo subas a git).
# En producción, estas mismas variables se cargan en Vercel → Project Settings → Environment Variables.

# --- Telegram ---
# Token que te da @BotFather al crear el bot con /newbot
TELEGRAM_BOT_TOKEN=

# Tu ID numérico de Telegram (preguntale a @userinfobot). Solo este usuario
# puede usar el bot — cualquier otro recibe "Este bot es privado."
ALLOWED_TELEGRAM_ID=

# --- GitHub (repo del sitio, donde vive data.json) ---
GITHUB_OWNER=Azerian126
GITHUB_REPO=Cantbelievetheview
GITHUB_BRANCH=main
# Personal Access Token (fine-grained) con permiso de escritura de "Contents"
# sobre ese repo únicamente. Se genera en github.com/settings/tokens
GITHUB_TOKEN=

# --- Cloudinary (donde se alojan las fotos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sesión (Upstash Redis, se conecta desde el dashboard de Vercel y estas
# variables se agregan solas al proyecto — normalmente no hace falta copiarlas
# a mano. Según la versión de la integración pueden llamarse KV_REST_API_* o
# UPSTASH_REDIS_REST_* — el bot reconoce cualquiera de las dos). ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
